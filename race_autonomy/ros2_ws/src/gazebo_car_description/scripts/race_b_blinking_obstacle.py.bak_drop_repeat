#!/usr/bin/env python3

import subprocess
import time

import rclpy
from ament_index_python.packages import get_package_share_directory
from rclpy.node import Node


class RaceBBlinkingObstacle(Node):
    def __init__(self):
        super().__init__('race_b_blinking_obstacle')

        package_share = get_package_share_directory('gazebo_car_description')
        default_sdf = f'{package_share}/models/race_B_obstacle_dynamic/model.sdf'

        self.declare_parameter('world_name', 'default')
        self.declare_parameter('model_name', 'race_B_obstacle_dynamic')
        self.declare_parameter('model_sdf', default_sdf)
        self.declare_parameter('x', 1.5)
        self.declare_parameter('y', 3.0)
        self.declare_parameter('z', 0.195)
        self.declare_parameter('yaw', 0.0)
        self.declare_parameter('on_duration_sec', 5.0)
        self.declare_parameter('off_duration_sec', 5.0)
        self.declare_parameter('retry_period_sec', 0.5)

        self.world_name = str(self.get_parameter('world_name').value)
        self.model_name = str(self.get_parameter('model_name').value)
        self.model_sdf = str(self.get_parameter('model_sdf').value)
        self.x = float(self.get_parameter('x').value)
        self.y = float(self.get_parameter('y').value)
        self.z = float(self.get_parameter('z').value)
        self.yaw = float(self.get_parameter('yaw').value)
        self.on_duration_sec = float(self.get_parameter('on_duration_sec').value)
        self.off_duration_sec = float(self.get_parameter('off_duration_sec').value)
        self.retry_period_sec = float(self.get_parameter('retry_period_sec').value)

        self._phase = 'spawn'
        self._spawned = False
        self._next_action_time = time.monotonic()
        self._timer = self.create_timer(0.1, self._tick)

        self.get_logger().info(
            'Race B blinking obstacle ready: '
            f'{self.model_name} at ({self.x:.3f}, {self.y:.3f}, {self.z:.3f}), '
            f'{self.on_duration_sec:.1f}s on / {self.off_duration_sec:.1f}s off'
        )

    def _tick(self):
        now = time.monotonic()
        if now < self._next_action_time:
            return

        if self._phase == 'spawn':
            self._call_spawn()
        elif self._phase == 'delete':
            self._call_delete()

    def _call_spawn(self):
        if self._model_exists():
            self.get_logger().info(
                f'{self.model_name} already exists; treating it as the on phase.'
            )
            self._spawned = True
            self._phase = 'delete'
            self._next_action_time = time.monotonic() + self.on_duration_sec
            return

        # ros_gz_sim create talks to Gazebo transport directly. In this repo's
        # launch stack there is no ROS /world/<name>/create service to call.
        cmd = [
            'ros2',
            'run',
            'ros_gz_sim',
            'create',
            '-world',
            self.world_name,
            '-file',
            self.model_sdf,
            '-name',
            self.model_name,
            '-allow_renaming',
            'false',
            '-x',
            f'{self.x:.6f}',
            '-y',
            f'{self.y:.6f}',
            '-z',
            f'{self.z:.6f}',
            '-Y',
            f'{self.yaw:.6f}',
        ]

        success = self._run_command(cmd, 'spawn')
        now = time.monotonic()

        if success:
            self.get_logger().info(f'Spawned {self.model_name}')
            self._spawned = True
            self._phase = 'delete'
            self._next_action_time = now + self.on_duration_sec
            return

        if self._model_exists():
            self.get_logger().info(
                f'{self.model_name} exists after spawn attempt; treating it as spawned.'
            )
            self._spawned = True
            self._phase = 'delete'
            self._next_action_time = now + self.on_duration_sec
            return

        self.get_logger().warn(
            f'Could not spawn {self.model_name}; retrying.'
        )
        self._spawned = False
        self._phase = 'spawn'
        self._next_action_time = now + self.retry_period_sec

    def _call_delete(self):
        if not self._spawned and not self._model_exists():
            self.get_logger().debug(
                f'{self.model_name} is not spawned; skipping delete command.'
            )
            self._phase = 'spawn'
            self._next_action_time = time.monotonic() + self.off_duration_sec
            return

        if not self._model_exists():
            self.get_logger().info(
                f'{self.model_name} is already absent; starting off phase.'
            )
            self._spawned = False
            self._phase = 'spawn'
            self._next_action_time = time.monotonic() + self.off_duration_sec
            return

        cmd = [
            'ros2',
            'run',
            'ros_gz_sim',
            'remove',
            '--ros-args',
            '-p',
            f'world:={self.world_name}',
            '-p',
            f'entity_name:={self.model_name}',
        ]

        success = self._run_command(cmd, 'delete')
        now = time.monotonic()

        if success:
            self.get_logger().info(f'Deleted {self.model_name}')
            self._spawned = False
            self._phase = 'spawn'
            self._next_action_time = now + self.off_duration_sec
            return

        if not self._model_exists():
            self.get_logger().info(
                f'{self.model_name} disappeared during delete; starting off phase.'
            )
            self._spawned = False
            self._phase = 'spawn'
            self._next_action_time = now + self.off_duration_sec
            return

        self.get_logger().warn(f'Could not delete {self.model_name}; retrying.')
        self._phase = 'delete'
        self._next_action_time = now + self.retry_period_sec

    def _model_exists(self):
        try:
            result = subprocess.run(
                ['gz', 'model', '--list'],
                check=False,
                capture_output=True,
                text=True,
                timeout=4.0,
            )
        except (subprocess.TimeoutExpired, OSError):
            return False

        if result.returncode != 0:
            return False

        for line in result.stdout.splitlines():
            text = line.strip()
            if text.startswith('- ') and text[2:].strip() == self.model_name:
                return True
        return False

    def _run_command(self, cmd, action):
        try:
            result = subprocess.run(
                cmd,
                check=False,
                capture_output=True,
                text=True,
                timeout=6.0,
            )
        except subprocess.TimeoutExpired:
            self.get_logger().warn(f'Obstacle {action} command timed out.')
            return False
        except OSError as exc:
            self.get_logger().warn(f'Could not start obstacle {action} command: {exc}')
            return False

        output = (result.stdout + result.stderr).strip()
        if result.returncode == 0:
            if output:
                self.get_logger().debug(output)
            return True

        if output:
            self.get_logger().warn(output)
        self.get_logger().warn(
            f'Obstacle {action} command exited with code {result.returncode}.'
        )
        return False


def main(args=None):
    rclpy.init(args=args)
    node = RaceBBlinkingObstacle()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
